GOOGLE_CLOUD_PROJECT="PROJECT_ID"
GOOGLE_CLOUD_LOCATION="LOCATION"
GOOGLE_CLOUD_PROJECT_NUMBER="PROJECT_NBR"

GOOGLE_GENAI_USE_VERTEXAI="True"
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

GEMINI_MODEL="gemini-2.5-pro"

BQ_DATASET_IN_SCOPE="capstone_ds"
BQ_METADATA_BUCKET="capstone_stage_<PROJECT_NBR>"
BQ_METADATA_FILE="metadata/captone_database_metadata_grounding.md"

DATA_ANALYST_USER_MANAGED_SERVICE_ACCOUNT_FQN="data-analyst-agent-sa@PROJECT_ID.iam.gserviceaccount.com"

AGENT_DEPLOYMENT_BUCKET="agent-deployment-bucket-PROJECT_NBR"
DEPLOYED_AGENT_RESOURCE_URI="projects/PROJECT_NBR/locations/us-central1/reasoningEngines/<TO-BE-DEPLOYED>"
